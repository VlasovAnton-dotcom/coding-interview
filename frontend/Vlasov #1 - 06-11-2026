4. Логика состояния (useReducer)
Редьюсер будет хранить Set нажатых в данный момент клавиш. Это позволяет нажимать несколько клавиш одновременно (аккорды).
typescriptКопировать
// src/components/Piano.tsx
import React, { useReducer, useEffect } from 'react';
import { PianoKey, PianoAction, PressAction, ReleaseAction } from '../types';
import { KEYS } from './keysData'; // Массив KEYS можно вынести в отдельный файл
import Key from './Key';

const initialState: Set<string> = new Set();

function pianoReducer(state: Set<string>, action: PianoAction): Set<string> {
  const newState = new Set(state);
  if (action.type === 'PRESS') {
    newState.add(action.keyId);
  } else if (action.type === 'RELEASE') {
    newState.delete(action.keyId);
  }
  return newState;
}

export default function Piano() {
  const [pressedKeys, dispatch] = useReducer(pianoReducer, initialState);

  // Воспроизведение звука
  useEffect(() => {
    if (pressedKeys.size > 0) {
      const keyId = pressedKeys.values().next().value; // Берем первую нажатую клавишу
      const audio = new Audio(`/sounds/${keyId}.mp3`);
      audio.currentTime = 0;
      audio.play().catch(err => console.warn("Autoplay prevented", err));
    }
  }, [pressedKeys]);

  const handleMouseDown = (keyId: string) => {
    dispatch({ type: 'PRESS', keyId });
  };

  const handleMouseUp = (keyId: string) => {
    dispatch({ type: 'RELEASE', keyId });
  };

  // Обработчики клавиатуры
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      const keyMap: Record<string, string> = {
        'a': 'C4', 'w': 'C#4', 's': 'D4', 'e': 'D#4', 'd': 'E4', 
        'f': 'F4', 't': 'F#4', 'g': 'G4', 'y': 'G#4', 'h': 'A4', 
        'u': 'A#4', 'j': 'B4'
      };
      const keyId = keyMap[e.key.toLowerCase()];
      if (keyId && !pressedKeys.has(keyId)) {
        dispatch({ type: 'PRESS', keyId });
      }
    };

    const handleKeyUp = (e: KeyboardEvent) => {
      const keyMap: Record<string, string> = {
        'a': 'C4', 'w': 'C#4', 's': 'D4', 'e': 'D#4', 'd': 'E4', 
        'f': 'F4', 't': 'F#4', 'g': 'G4', 'y': 'G#4', 'h': 'A4', 
        'u': 'A#4', 'j': 'B4'
      };
      const keyId = keyMap[e.key.toLowerCase()];
      if (keyId && pressedKeys.has(keyId)) {
        dispatch({ type: 'RELEASE', keyId });
      }
    };

    window.addEventListener('keydown', handleKeyDown);
    window.addEventListener('keyup', handleKeyUp);

    return () => {
      window.removeEventListener('keydown', handleKeyDown);
      window.removeEventListener('keyup', handleKeyUp);
    };
  }, [pressedKeys]);

  return (
    <div className="piano">
      {KEYS.map(key => (
        <Key
          key={key.id}
          keyData={key}
          isPressed={pressedKeys.has(key.id)}
          onMouseDown={() => handleMouseDown(key.id)}
          onMouseUp={() => handleMouseUp(key.id)}
        />
      ))}
    </div>
  );
}
Важное замечание по UX: Для черных клавиш onMouseUp лучше вешать на document, а не на саму клавишу. Если пользователь нажал черную клавишу, увел мышь в сторону и отпустил, событие mouseup не сработает на элементе, и клавиша «залипнет» в нажатом состоянии. В упрощенном примере выше это опущено для краткости, но в продакшене стоит добавить useEffect с document.addEventListener('mouseup', ...) для сброса состояния.
5. Компонент клавиши (Key.tsx)
Компонент получает данные о клавише и флаг нажатости.
typescriptКопировать
// src/components/Key.tsx
import React from 'react';
import { PianoKey } from '../types';

interface KeyProps {
  keyData: PianoKey;
  isPressed: boolean;
  onMouseDown: () => void;
  onMouseUp: () => void;
}

const Key: React.FC<KeyProps> = ({ keyData, isPressed, onMouseDown, onMouseUp }) => {
  return (
    <div
      className={`key ${keyData.isBlack ? 'black' : 'white'} ${isPressed ? 'pressed' : ''}`}
      onMouseDown={onMouseDown}
      onMouseUp={onMouseUp}
      // Предотвращаем появление синего выделения при долгом нажатии
      onMouseDownCapture={e => e.preventDefault()}
      role="button"
      tabIndex={0}
      aria-label={`Нота ${keyData.note}${keyData.octave}`}
    />
  );
};

export default Key;
6. Стили (styles.css)
Самая важная часть для пианино — позиционирование черных клавиш поверх белых с помощью position: absolute.
cssКопировать
/* src/styles.css */
body {
  background-color: #333;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  margin: 0;
}

.piano {
  display: flex;
  position: relative;
  border: 4px solid #000;
  border-radius: 8px;
  background-color: #000;
  padding: 10px; /* Отступ для белых клавиш */
  user-select: none;
}

.key {
  height: 200px;
  border: 1px solid #000;
  cursor: pointer;
  transition: transform 0.05s ease-out, box-shadow 0.05s ease-out;
}

.white {
  width: 40px;
  background-color: #fff;
  border-radius: 0 0 5px 5px;
  z-index: 1;
}

.black {
  width: 25px;
  height: 120px;
  background-color: #000;
  border-radius: 0 0 3px 3px;
  position: absolute;
  z-index: 2;
  margin-left: -12.5px; /* Половина ширины черной клавиши для центрирования */
}

/* Позиционирование черных клавиш вручную */
.key[data-note="C#4"] { left: 28px; } /* (40 / 2) - (25 / 2) = 7.5, но с учетом отступов проще подобрать */
.key[data-note="D#4"] { left: 98px; }
.key[data-note="F#4"] { left: 183px; }
.key[data-note="G#4"] { left: 238px; }
.key[data-note="A#4"] { left: 293px; }

/* Альтернативный способ позиционирования через классы родительского контейнера */
.piano > .key.black:nth-child(2) { left: 28px; }
.piano > .key.black:nth-child(4) { left: 98px; }
.piano > .key.black:nth-child(7) { left: 183px; }
.piano > .key.black:nth-child(9) { left: 238px; }
.piano > .key.black:nth-child(11) { left: 293px; }

/* Визуальное состояние нажатия */
.pressed {
  transform: translateY(3px);
  box-shadow: 0 1px 0 rgba(0,0,0,0.5) inset;
}

.white.pressed {
  background-color: #ddd;
}

.black.pressed {
  background-color: #444;
}
Примечание к CSS: Чтобы не высчитывать left вручную, можно генерировать стили динамически в JS, передавая style={{ left: ... }} в компонент Key, основываясь на индексе предыдущей белой клавиши.
