// src/types.ts
export type NoteName = 'C' | 'C#' | 'D' | 'D#' | 'E' | 'F' | 'F#' | 'G' | 'G#' | 'A' | 'A#' | 'B';

export interface PianoKey {
  id: string; // Уникальный id для React (например, "C4", "C#4")
  note: NoteName;
  octave: number;
  isBlack: boolean;
}

// Типы для экшенов редьюсера
type PressAction = { type: 'PRESS'; keyId: string };
type ReleaseAction = { type: 'RELEASE'; keyId: string };
type PianoAction = PressAction | ReleaseAction;
3. Данные и звуки
Октава состоит из 12 клавиш (7 белых, 5 черных). Создадим массив клавиш. Звуки (формата .mp3 или .wav) нужно положить в папку public/sounds/. Имена файлов должны соответствовать id клавиши (например, C4.mp3, F#4.mp3). 
Примечание: звуки нот (MIDI или записанные сэмплы) можно найти в открытых библиотеках (например, в наборе Sonatina Symphonic Orchestra или на сайте freesound.org).
